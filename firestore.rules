        && encrypted(request.resource.data.notes, [request.resource.data.authorId])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/medical_records/$(id))
        && matchingRecord(request.resource.data, id);
      allow list, update, delete: if false;
    }
    // Account-wide data-rights requests have no clinic scope or clinical text.
    // Only a trusted operator can later verify and fulfil an action; client
    // Rules expose no completed status transition.
    match /privacy_requests/{id} {
      function requestShape(data) {
        return validId(id)
          && data.keys().hasOnly([
            'requestId', 'userId', 'type', 'status', 'createdAt',
            'updatedAt', 'reviewedBy', 'reviewedAt', 'resolvedAt', 'resolution', 'receiptId'
          ])
          && data.keys().hasAll([
            'requestId', 'userId', 'type', 'status', 'createdAt', 'updatedAt'
          ])
          && data.requestId == id && validId(data.userId)
          && data.type in ['access', 'correction', 'deletion']
          && data.status in ['pending', 'under_review', 'fulfilled', 'partially_fulfilled', 'declined']
          && data.createdAt is timestamp && data.updatedAt is timestamp;
      }
      allow get: if activeUser() && requestShape(resource.data)
        && (resource.data.userId == request.auth.uid || platformAdmin());
      allow list: if activeUser() && boundedQuery()
        && (resource.data.userId == request.auth.uid || platformAdmin());
      allow create: if activeUser() && requestShape(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'requestId', 'userId', 'type', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if platformAdmin() && requestShape(resource.data)
        && requestShape(request.resource.data)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'under_review'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /access_logs/{id} {
      allow get: if activeUser()
        && clinicAdmin(resource.data.clinicId, 'audit.read');
      allow list: if boundedQuery() && activeUser()
        && clinicAdmin(resource.data.clinicId, 'audit.read');
      allow write: if false;
    }
    match /privacy_receipts/{id} {
      allow get: if activeUser() && (resource.data.userId == request.auth.uid || platformAdmin());
      allow list,write: if false;
    }
    match /privacy_jobs/{id} { allow read,write: if false; }
    match /operator_actions/{id} { allow read,write: if false; }
    match /platform_metrics/{id} {
      allow get: if id == 'current' && platformAdmin();
      allow list,write: if false;
    }

    // Own, generic states observed by an online client. This is not a trusted
    // delivery ledger or exhaustive audit. No arbitrary message text is stored.
    match /notification_history/{uid}/items/{eventId} {
      function shape(data) {
        return data.keys().hasOnly(['kind','sourceId','status','sourceAt','role','clinicId','observedAt','read'])
          && data.keys().hasAll(['kind','sourceId','status','sourceAt','role','clinicId','observedAt','read'])
          && data.kind in ['appointment','referral','specialist']
          && validId(data.sourceId) && data.sourceAt is timestamp
          && data.observedAt is timestamp && data.read is bool
          && (data.role == 'patient' && data.clinicId == ''
            || data.role in ['doctor','specialist'] && validId(data.clinicId))
          && (data.kind == 'appointment'
              && data.role in ['patient','doctor']
              && data.status in ['booked','cancelled','checked_in','called','completed','check_in_cancelled']
            || data.kind == 'referral'
              && data.status in ['pending','accepted','rejected','completed']
            || data.kind == 'specialist' && data.role in ['patient','specialist']
              && data.status in ['booked','cancelled','completed'])
          && eventId == data.kind + '-' + data.sourceId + '-'
            + string(data.sourceAt.toMillis()) + '-' + data.role + '-'
            + (data.clinicId == '' ? 'own' : data.clinicId);
      }
      function sourceMatches(data) {
        let source = data.kind == 'appointment'
          ? get(/databases/$(database)/documents/appointments/$(data.sourceId)).data
          : data.kind == 'referral'
          ? get(/databases/$(database)/documents/referrals/$(data.sourceId)).data
          : get(/databases/$(database)/documents/specialist_appointments/$(data.sourceId)).data;
        return source.status == data.status && source.updatedAt == data.sourceAt
          && (data.role == 'patient' && source.patientId == uid
            || data.role == 'doctor' && data.kind == 'appointment'
              && source.providerId == uid && source.clinicId == data.clinicId
              && activeDoctor(data.clinicId,uid)
            || data.role == 'doctor' && data.kind == 'referral'
              && source.referringDoctorId == uid && source.clinicId == data.clinicId
              && referralMetadata(source,data.sourceId) && referralAuthority(source,data.sourceId)
            || data.role == 'specialist' && data.kind == 'referral'
              && source.specialistId == uid && referralDestination(source) == data.clinicId
              && referralMetadata(source,data.sourceId) && referralAuthority(source,data.sourceId)
            || data.role == 'specialist' && data.kind == 'specialist'
              && source.providerId == uid && source.clinicId == data.clinicId
              && activeSpecialist(data.clinicId,uid));
      }
      allow get: if activeUser() && uid == request.auth.uid;
      allow list: if activeUser() && uid == request.auth.uid && boundedQuery();
      allow create: if activeUser() && uid == request.auth.uid
        && shape(request.resource.data) && sourceMatches(request.resource.data)
        && request.resource.data.observedAt == request.time
        && request.resource.data.read == false;
      allow update: if activeUser() && uid == request.auth.uid
        && shape(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
