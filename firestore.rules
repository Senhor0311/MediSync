      }
      allow create,update: if activeUser() && validReader(request.resource.data);
      allow get: if activeUser() && (!exists(/databases/$(database)/documents/record_head_readers/$(root)/specialists/$(specialist)) || resource.data.patientId == request.auth.uid);
      allow list,delete: if false;
    }
    match /record_share_details/{id} {
      function validDetails(data) {
        let share = getAfter(/databases/$(database)/documents/record_shares/$(id)).data;
        let record = get(/databases/$(database)/documents/medical_records/$(share.recordId)).data;
        return data.keys().hasOnly(['shareId','recordId','rootRecordId','visitAt','createdAt','recordType','attribution'])
          && data == {'shareId':id,'recordId':record.recordId,'rootRecordId':record.get('rootRecordId',record.recordId),
            'visitAt':record.visitAt,'createdAt':record.createdAt,'recordType':record.recordType,
            'attribution': exists(/databases/$(database)/documents/record_attribution/$(record.recordId)) ? get(/databases/$(database)/documents/record_attribution/$(record.recordId)).data : {'recordId':record.recordId}}
          && share.patientId == request.auth.uid && share.updatedAt == request.time && share.status == 'active';
      }
      allow create: if activeUser() && validDetails(request.resource.data);
      allow update: if activeUser() && validDetails(request.resource.data) && request.resource.data == resource.data;
      allow get: if activeUser() && (!exists(/databases/$(database)/documents/record_share_details/$(id))
        || sharedMetadataReader(get(/databases/$(database)/documents/record_shares/$(id)).data));
      allow list,delete: if false;
    }
    match /record_shares/{id} {
      function indexMatches(data) {
        return getAfter(/databases/$(database)/documents/record_share_index/$(id)).data
          == {'shareId':id,'referralId':data.referralId,'patientId':data.patientId,'specialistId':data.specialistId,'destinationClinicId':data.destinationClinicId,'status':data.status,'shareRevision':data.shareRevision,'updatedAt':data.updatedAt};
      }
      function shareRead(data) {
        let referral = get(/databases/$(database)/documents/referrals/$(data.referralId)).data;
        return activeUser() && encrypted(data.content, [data.specialistId])
          && (data.patientId == request.auth.uid || data.specialistId == request.auth.uid
            && data.status == 'active' && data.expiresAt > request.time
            && referral.status == 'accepted' && referral.patientId == data.patientId
            && referral.specialistId == data.specialistId && namedReferralAccess(referral));
      }
      function sourceCopy(data) {
        let record = get(/databases/$(database)/documents/medical_records/$(data.recordId)).data;
        let referral = get(/databases/$(database)/documents/referrals/$(data.referralId)).data;
        return record.patientId == data.patientId && record.patientVisible == true
          && record.authorId == data.authorId && record.authorId == referral.referringDoctorId
          && record.clinicId == data.clinicId && record.clinicId == referral.clinicId
          && record.encounterType == 'appointment' && data.encounterType == 'appointment'
          && record.encounterId == data.encounterId && record.encounterId == referral.sourceAppointmentId
          && record.revision == data.revision && record.content.payload == data.content.payload
          && referral.referralId == data.referralId && referral.patientId == data.patientId
          && referral.specialistId == data.specialistId && referral.status == 'accepted'
          && referralDestination(referral) == data.destinationClinicId
          && referralClinicalWindow(referral)
          && activeDoctor(data.clinicId, referral.referringDoctorId)
          && activeSpecialist(data.destinationClinicId, data.specialistId)
          && referralSource(referral)
          && get(/databases/$(database)/documents/patient_controls/$(data.patientId)).data.status == 'consented'
          && get(/databases/$(database)/documents/patient_controls/$(data.patientId)).data.consentVersion == referral.consentVersion;
      }
      function readerFollows(data) {
        let source = get(/databases/$(database)/documents/medical_records/$(data.recordId)).data;
        let root = source.get('rootRecordId',source.recordId);
        let path = /databases/$(database)/documents/record_head_readers/$(root)/specialists/$(data.specialistId);
        return !exists(path) || get(path).data.shareId != id
          || getAfter(path).data.status == data.status && getAfter(path).data.expiresAt == data.expiresAt;
      }
      function shareShape(data) {
        return data.keys().hasOnly(['shareId','referralId','recordId','clinicId','patientId','authorId','encounterType','encounterId','revision','specialistId','destinationClinicId','status','createdAt','updatedAt','expiresAt','shareRevision','content'])
          && validId(data.referralId) && validId(data.recordId)
          && data.shareId == id && id == data.referralId + '-' + data.recordId
          && data.patientId == request.auth.uid && data.status == 'active'
          && data.createdAt is timestamp && data.updatedAt == request.time
          && data.shareRevision is int && data.expiresAt is timestamp
          && data.expiresAt > request.time && data.expiresAt <= request.time + duration.value(24,'h')
          && encrypted(data.content,[data.specialistId]);
      }
      allow get: if activeUser() && (!exists(/databases/$(database)/documents/record_shares/$(id)) || shareRead(resource.data));
      allow list: if false;
      allow create: if activeUser() && shareShape(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.shareRevision == 1
        && indexMatches(request.resource.data)
        && sourceCopy(request.resource.data);
      allow update: if activeUser() && resource.data.patientId == request.auth.uid
        && request.resource.data.shareRevision == resource.data.shareRevision + 1
        && request.resource.data.updatedAt == request.time
        && indexMatches(request.resource.data) && readerFollows(request.resource.data)
        && (request.resource.data.status == 'revoked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','shareRevision'])
          || shareShape(request.resource.data) && sourceCopy(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content','status','expiresAt','updatedAt','shareRevision']));
      allow delete: if false;
    }
    match /record_share_index/{id} {
      allow get: if activeUser() && (resource.data.patientId == request.auth.uid
        || resource.data.specialistId == request.auth.uid && activeSpecialist(resource.data.destinationClinicId,request.auth.uid));
      allow list: if activeUser() && boundedQuery() && (resource.data.patientId == request.auth.uid
        || resource.data.specialistId == request.auth.uid && activeSpecialist(resource.data.destinationClinicId,request.auth.uid));
      function paired() {
        let share = getAfter(/databases/$(database)/documents/record_shares/$(id)).data;
        return request.resource.data == {'shareId':id,'referralId':share.referralId,'patientId':share.patientId,'specialistId':share.specialistId,'destinationClinicId':share.destinationClinicId,'status':share.status,'shareRevision':share.shareRevision,'updatedAt':share.updatedAt}
          && share.patientId == request.auth.uid && share.updatedAt == request.time
          && (!exists(/databases/$(database)/documents/record_shares/$(id))
            || get(/databases/$(database)/documents/record_shares/$(id)).data.shareRevision + 1 == share.shareRevision);
      }
      allow create,update: if activeUser() && paired();
      allow delete: if false;
    }
    // Written-record projections (31 October): no narrative, no public lists.
    // encounter_labels: patient/clinic/encounter IDs, own validated displayName,
    // server updatedAt. record_attribution: record ID and optional directory names.
    match /encounter_labels/{id} {
      function validLabel(data) {
        return data.keys().hasOnly(['patientId','clinicId','encounterType','encounterId','displayName','updatedAt'])
          && data.keys().hasAll(['patientId','clinicId','encounterType','encounterId','displayName','updatedAt'])
          && validId(data.patientId) && validId(data.clinicId) && validId(data.encounterId)
          && data.encounterType in ['appointment','referral']
          && id == data.encounterType + '-' + data.encounterId
          && textWithin(data.displayName,1,100) && data.updatedAt == request.time;
      }
      function labelSource(data) {
        let appointment = get(/databases/$(database)/documents/appointments/$(data.encounterId)).data;
        return appointment.patientId == data.patientId && appointment.clinicId == data.clinicId
          && appointment.status in ['called','completed'];
      }
      function labelReferral(data) {
        let referral = getAfter(/databases/$(database)/documents/referrals/$(data.encounterId)).data;
        return referral.patientId == data.patientId && referralDestination(referral) == data.clinicId;
      }
      function labelWriter(data) {
        return activeUser() && validLabel(data) && (
          data.patientId == request.auth.uid
            && data.displayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
            && (data.encounterType == 'appointment' ? labelSource(data) : labelReferral(data))
          || data.encounterType == 'referral' && labelReferral(data)
            && getAfter(/databases/$(database)/documents/referrals/$(data.encounterId)).data.referringDoctorId == request.auth.uid
            && data.displayName == get(/databases/$(database)/documents/encounter_labels/$('appointment-' + getAfter(/databases/$(database)/documents/referrals/$(data.encounterId)).data.sourceAppointmentId)).data.displayName
            && care(getAfter(/databases/$(database)/documents/referrals/$(data.encounterId)).data.clinicId, data.patientId, 'appointment', getAfter(/databases/$(database)/documents/referrals/$(data.encounterId)).data.sourceAppointmentId));
      }
      allow create: if labelWriter(request.resource.data);
      allow update: if labelWriter(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt']);
      allow get: if activeUser() && (!exists(/databases/$(database)/documents/encounter_labels/$(id))
        || resource.data.patientId == request.auth.uid || practitionerSummaryRead(resource.data));
      allow list,delete: if false;
    }
    match /record_attribution/{id} {
      function validAttribution(data) {
        let record = getAfter(/databases/$(database)/documents/medical_records/$(id)).data;
        return data.keys().hasOnly(['recordId','clinicName','providerName']) && data.recordId == id
          && record.authorId == request.auth.uid && record.createdAt == request.time
          && !exists(/databases/$(database)/documents/medical_records/$(id))
          && (!data.keys().hasAny(['clinicName']) || textWithin(data.clinicName,1,100)
            && (data.clinicName == get(/databases/$(database)/documents/clinic_directory/$(record.clinicId)).data.displayName
              || record.revision > 1 && data.clinicName == get(/databases/$(database)/documents/record_attribution/$(record.supersedesId)).data.clinicName))
          && (!data.keys().hasAny(['providerName']) || textWithin(data.providerName,1,100)
            && (data.providerName == get(/databases/$(database)/documents/provider_directory/$(record.authorId)).data.displayName
              || record.revision > 1 && data.providerName == get(/databases/$(database)/documents/record_attribution/$(record.supersedesId)).data.providerName));
      }
      allow create: if activeUser() && validAttribution(request.resource.data);
      allow get: if activeUser() && (!exists(/databases/$(database)/documents/record_attribution/$(id))
        || get(/databases/$(database)/documents/medical_records/$(id)).data.patientId == request.auth.uid
          && get(/databases/$(database)/documents/medical_records/$(id)).data.patientVisible
        || practitionerSummaryRead(get(/databases/$(database)/documents/medical_records/$(id)).data));
      allow list,update,delete: if false;
    }
    match /record_summaries/{id} {
      function summaryRead() {
        return activeUser() && validSummary(resource.data, id) && (
          (patientOwner(resource.data) && resource.data.patientVisible == true)
          || practitionerSummaryRead(resource.data)
        );
      }
      allow get: if activeUser() && (!exists(/databases/$(database)/documents/record_summaries/$(id)) || summaryRead());
      allow list: if boundedQuery() && activeUser() && (
        (patientOwner(resource.data) && resource.data.patientVisible == true)
        || practitionerSummaryRead(resource.data)
      );
      // A summary is only created with its matching clinical document.
      // No client can add narrative or later change its visibility/status.
      // Full metadata validation is performed by the inseparable new record.
      // Equality below rejects omissions/forgeries; this allow-list excludes
      // clinical fields while avoiding duplicate schema work in the same batch.
      allow create: if summaryProjectionShape(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && practitionerSummaryRead(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/medical_records/$(id))
        && matchingRecord(request.resource.data, id);
      allow update, delete: if false;
    }
    match /medical_records/{id} {
      function recordRead() {
        return activeUser() && validRecord(resource.data, id) && (
          (patientOwner(resource.data) && resource.data.patientVisible == true)
          || practitionerSummaryRead(resource.data)
        );
      }
      allow get: if recordRead();
      allow list: if boundedQuery() && activeUser() && (
        (patientOwner(resource.data) && resource.data.patientVisible == true)
        || practitionerSummaryRead(resource.data)
      );
      // Final versions are immutable. Corrections create a new paired version
      // and advance its monotonic head; they never update an original.
      // Exact clinical authority is enforced by the inseparable new summary.
      // !exists(summary) + getAfter metadata equality require its create rule
      // (including current care/consent) to pass in this same atomic operation.
      allow create: if validRecord(request.resource.data, id)
        && validRecordVersion(request.resource.data, id)
        && (request.resource.data.revision > 1 || encounterVisitDate(request.resource.data))
        // validRecord already validates the full encrypted schema. This extra
        // discriminator excludes its historical plaintext-read branch.
        && request.resource.data.content.format == 'medisync-clinical-v1'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/record_summaries/$(id))
        && matchingSummary(request.resource.data, id);
      allow update, delete: if false;
    }

    // Whole-document boundary: patient reads can never disclose this document.
    // Only the named author with current exact encounter authority may read it.
    match /internal_record_notes/{id} {
      function noteReader() {
        let record = get(/databases/$(database)/documents/medical_records/$(id)).data;
        return activeUser() && record.authorId == request.auth.uid
          && practitionerSummaryRead(record);
      }
      allow get: if noteReader();
      // This new note requires the new medical record, whose mandatory new
      // summary enforces exact clinical authority. No standalone note is valid.
      allow create: if request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['recordId', 'clinicId', 'patientId', 'authorId',
          'status', 'recordType', 'patientVisible', 'revision', 'visitAt', 'encounterType',
          'encounterId', 'createdAt', 'updatedAt', 'notes', 'rootRecordId', 'supersedesId', 'dateSource'])
