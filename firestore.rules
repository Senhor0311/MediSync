          && (!exists(/databases/$(database)/documents/referrals/$(id))
            || get(/databases/$(database)/documents/referrals/$(id)).data.status != after.status);
      }
      allow create, update: if pairedMutation();
      allow delete: if false;
    }

    function referralCreate(id) {
      let data = request.resource.data;
      return activeUser() && validReferral(data, id)
        && !data.keys().hasAny(['visitAccess','visitAccessRevokedAt'])
        && data.status == 'pending' && data.referringDoctorId == request.auth.uid
        && data.createdAt == request.time && data.updatedAt == request.time
        && activeDoctor(data.clinicId, request.auth.uid)
        && care(data.clinicId, data.patientId, 'appointment', data.sourceAppointmentId)
        && get(/databases/$(database)/documents/users/$(data.patientId)).data.status == 'active'
        // Exact appointment identity/provider/status already proved by the
        // mandatory care(...,'appointment',sourceAppointmentId) above.
        && (!data.keys().hasAny(['destinationClinicId'])
          || get(/databases/$(database)/documents/patient_controls/$(data.patientId)).data.consentVersion == data.consentVersion)
        && !exists(/databases/$(database)/documents/referral_inbox/$(id))
        && inboxMatches(data, id)
        && (!data.keys().hasAny(['destinationClinicId']) || referralOperationsMatch(data, id));
    }

    // Both documents must be new and written together. Validate the recipient
    // on the inbox write to stay within Firestore's per-document read budget.
    function referralInboxCreate(id) {
      let data = request.resource.data;
      let referral = getAfter(/databases/$(database)/documents/referrals/$(id)).data;
      // A new paired referral authenticates the shared caller. No existing or
      // standalone inbox can pass !exists + getAfter in this atomic operation.
      return validId(id)
        && data.keys().hasOnly(['referralId', 'clinicId', 'specialistId', 'patientId'])
        && data.keys().hasAll(['referralId', 'clinicId', 'specialistId'])
        && data.referralId == id
        && !exists(/databases/$(database)/documents/referrals/$(id))
        && referralDestination(referral) == data.clinicId
        && referral.specialistId == data.specialistId
        && (!data.keys().hasAny(['patientId']) || data.patientId == referral.patientId)
        && referral.referringDoctorId == request.auth.uid
        && activeSpecialist(data.clinicId, data.specialistId)
        && approvedSpecialist(data.clinicId, data.specialistId)
        && get(/databases/$(database)/documents/users/$(data.specialistId)).data.status == 'active';
    }

    match /referral_inbox/{id} {
      function patientSchedulingPointer() {
        let referral = get(/databases/$(database)/documents/referrals/$(id)).data;
        let after = request.resource.data;
        return activeUser() && referral.patientId == request.auth.uid
          && referral.referralId == id && referral.status == 'accepted'
          && resource.data.referralId == id
          && resource.data.clinicId == referralDestination(referral)
          && resource.data.specialistId == referral.specialistId
          && after.diff(resource.data).affectedKeys().hasOnly(['patientId'])
          && after.patientId == referral.patientId;
      }
      allow get: if activeUser() && resource.data.referralId == id
        && resource.data.specialistId == request.auth.uid
        && activeSpecialist(resource.data.clinicId, request.auth.uid);
      allow list: if activeUser() && boundedQuery()
