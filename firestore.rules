    }
    match /specialist_appointment_versions/{id} {
      allow get: if specialistAppointmentRead(resource.data);
      allow list: if boundedQuery() && specialistAppointmentRead(resource.data);
      allow create: if activeUser() && id == request.resource.data.referralId + '-v' + string(request.resource.data.revision)
        && (request.resource.data.status != 'booked' || specialistReferralBooking(request.resource.data,request.resource.data.referralId))
        && getAfter(/databases/$(database)/documents/specialist_appointments/$(request.resource.data.referralId)).data == request.resource.data
        && request.resource.data.updatedAt == request.time
        && (!exists(/databases/$(database)/documents/specialist_appointments/$(request.resource.data.referralId)) && request.resource.data.revision == 1
          || get(/databases/$(database)/documents/specialist_appointments/$(request.resource.data.referralId)).data.revision + 1 == request.resource.data.revision);
      allow update,delete: if false;
    }
    function sharedMetadataReader(share) {
      let referral = get(/databases/$(database)/documents/referrals/$(share.referralId)).data;
      return activeUser() && (share.patientId == request.auth.uid
        || share.specialistId == request.auth.uid && share.status == 'active'
          && share.expiresAt > request.time && referral.status == 'accepted'
          && referral.patientId == share.patientId && referral.specialistId == share.specialistId
          && namedReferralAccess(referral));
    }
    // This grants only the monotonic head ID/revision, never future ciphertext.
    match /record_head_readers/{root}/specialists/{specialist} {
      function validReader(data) {
        let share = getAfter(/databases/$(database)/documents/record_shares/$(data.shareId)).data;
        let record = get(/databases/$(database)/documents/medical_records/$(share.recordId)).data;
        return data == {'shareId':share.shareId,'rootRecordId':root,'referralId':share.referralId,
            'patientId':share.patientId,'specialistId':share.specialistId,'destinationClinicId':share.destinationClinicId,
            'status':share.status,'expiresAt':share.expiresAt}
          && data.rootRecordId == root && record.get('rootRecordId',record.recordId) == root
