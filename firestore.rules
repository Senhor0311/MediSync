      }
      allow get: if referralRead(resource.data, id);
      allow list: if boundedQuery() && activeUser()
        && (resource.data.patientId == request.auth.uid
          || resource.data.referringDoctorId == request.auth.uid
            && activeDoctor(resource.data.clinicId, request.auth.uid)
