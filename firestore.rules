    }

    function validReferral(data, id) {
      return referralMetadata(data, id) && (textWithin(data.reason, 1, 200) || referralEncrypted(data.reason, data));
    }
    function referralMetadata(data, id) {
      return validId(id)
        && data.keys().hasOnly(['referralId', 'clinicId', 'patientId',
          'referringDoctorId', 'specialistId', 'sourceAppointmentId',
          'priority', 'reason', 'status', 'createdAt', 'updatedAt',
          'decisionAt', 'rejectionReason', 'completedAt', 'destinationClinicId', 'consentVersion', 'visitAccess', 'visitAccessRevokedAt'])
        && data.keys().hasAll(['referralId', 'clinicId', 'patientId',
          'referringDoctorId', 'specialistId', 'sourceAppointmentId',
          'priority', 'reason', 'status', 'createdAt', 'updatedAt'])
        && data.referralId == id && validId(data.clinicId)
        && validId(data.patientId) && validId(data.referringDoctorId)
        && validId(data.specialistId) && validId(data.sourceAppointmentId)
        && data.referringDoctorId != data.specialistId
        && data.priority in ['routine', 'urgent']
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (!data.keys().hasAny(['destinationClinicId', 'consentVersion'])
          || validId(data.destinationClinicId) && data.consentVersion is int && data.consentVersion > 0)
        && (data.status == 'pending'
          && !data.keys().hasAny(['decisionAt', 'rejectionReason', 'completedAt'])
          || data.status == 'accepted' && data.decisionAt is timestamp
            && !data.keys().hasAny(['rejectionReason', 'completedAt'])
          || data.status == 'rejected' && data.decisionAt is timestamp
            && (textWithin(data.rejectionReason, 1, 160) || referralEncrypted(data.rejectionReason, data))
            && !data.keys().hasAny(['completedAt'])
          || data.status == 'completed' && data.decisionAt is timestamp
            && data.completedAt is timestamp
            && !data.keys().hasAny(['rejectionReason']));
    }

    function referralRead(data, id) {
      return activeUser() && validReferral(data, id)
        && referralAuthority(data,id);
    }
    function referralAuthority(data,id) {
      return data.referralId == id && (data.patientId == request.auth.uid
          || data.referringDoctorId == request.auth.uid
            && activeDoctor(data.clinicId, request.auth.uid)
            && care(data.clinicId, data.patientId, 'appointment', data.sourceAppointmentId)
          || data.specialistId == request.auth.uid
            && (data.keys().hasAny(['destinationClinicId']) ? namedReferralAccess(data)
              : activeSpecialist(data.clinicId, request.auth.uid)
                && careFor(data.clinicId, data.patientId, request.auth.uid, 'referral', id)));
    }

    function referralSource(data) {
      let appointment = get(/databases/$(database)/documents/appointments/$(data.sourceAppointmentId)).data;
      return appointment.appointmentId == data.sourceAppointmentId
        && appointment.clinicId == data.clinicId
        && appointment.patientId == data.patientId
        && appointment.providerId == data.referringDoctorId
        && appointment.status in ['called', 'completed'];
    }

    function inboxMatches(data, id) {
      let inbox = getAfter(/databases/$(database)/documents/referral_inbox/$(id)).data;
      return inbox.referralId == id && inbox.clinicId == referralDestination(data)
        && inbox.specialistId == data.specialistId;
    }

    // Nonclinical operational projection. Both directions require the pair;
    // administrators can count referrals without reading a reason or patient ID.
    function operationsShape(data, id) {
      return {'referralId': id, 'clinicId': data.clinicId,
        'destinationClinicId': data.destinationClinicId,
        'status': data.status, 'updatedAt': data.updatedAt};
    }
    function operationsAtClinic(data, id, clinicId) {
      return getAfter(/databases/$(database)/documents/clinic_referral_operations/$(clinicId)/items/$(id)).data
        == operationsShape(data, id);
    }
    function referralOperationsMatch(data, id) {
      return operationsAtClinic(data, id, data.clinicId)
        && (data.clinicId == data.destinationClinicId
          || operationsAtClinic(data, id, data.destinationClinicId));
    }

    match /clinic_referral_operations/{clinicId}/items/{id} {
      function namedOperationalRecipient() {
        let referral = get(/databases/$(database)/documents/referrals/$(id)).data;
        return activeUser() && resource.data.referralId == id
          && clinicId == referralDestination(referral)
          && referral.specialistId == request.auth.uid
          && activeSpecialist(clinicId,request.auth.uid);
      }
      // Exact, already-assigned metadata only: no patient ID, reason or content.
      allow get: if clinicAdmin(clinicId, 'operational.read') || namedOperationalRecipient();
      allow list: if boundedQuery() && clinicAdmin(clinicId, 'operational.read');
      function pairedMutation() {
        let after = getAfter(/databases/$(database)/documents/referrals/$(id)).data;
        // The referral rule authenticates and authorises the shared request.
        // Map equality enforces the entire projection with no extra fields.
        return request.resource.data == operationsShape(after, id)
          && clinicId in [after.clinicId, after.destinationClinicId]
