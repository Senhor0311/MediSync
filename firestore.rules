    function specialistScheduleManager(clinicId, uid) {
      return activeUser() && activeSpecialist(clinicId,uid)
        && (request.auth.uid == uid || clinicAdmin(clinicId,'operational.read'));
    }
    function specialistAppointmentRead(data) {
      return activeUser() && (data.patientId == request.auth.uid
        || data.providerId == request.auth.uid && activeSpecialist(data.clinicId,request.auth.uid)
        || clinicAdmin(data.clinicId,'operational.read'));
    }
    function specialistAppointmentShape(data,id) {
      return data.keys().hasOnly(['referralId','clinicId','providerId','patientId','slotId','startAt','endAt','status','revision','bookedBy','updatedBy','createdAt','updatedAt'])
        && data.referralId == id && validId(id) && validId(data.clinicId) && validId(data.providerId)
        && validId(data.patientId) && validId(data.slotId) && validId(data.bookedBy) && validId(data.updatedBy)
        && data.startAt is timestamp && data.endAt is timestamp && data.endAt > data.startAt
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.revision is int && data.revision >= 1 && data.revision <= 1000
        && data.status in ['booked','cancelled','completed'];
    }
    function specialistReferralBooking(data,id) {
      // getAfter also supports the specialist's atomic accept-and-reserve action.
      let referral = getAfter(/databases/$(database)/documents/referrals/$(id)).data;
      let consent = get(/databases/$(database)/documents/patient_controls/$(data.patientId)).data;
      return activeUser() && request.auth.uid in [data.patientId,data.providerId]
        && providerAccountActive(data.providerId)
        && referral.referralId == id && referral.status == 'accepted'
        && referral.patientId == data.patientId && referral.specialistId == data.providerId
        && referralDestination(referral) == data.clinicId
        // Operational reservation only; no extension of clinical authority.
        && data.startAt <= request.time + duration.value(90,'d')
        && data.startAt > request.time
        // Destination specialist membership/listing are checked by the NEW
        // mandatory slot reservation; the immutable version checks this source
        // context. Both are required by the main appointment in the same batch.
        && activeDoctor(referral.clinicId,referral.referringDoctorId) && referralSource(referral)
        && get(/databases/$(database)/documents/users/$(data.patientId)).data.status == 'active'
        && consent.patientId == data.patientId && consent.status == 'consented'
        && consent.consentVersion == referral.consentVersion;
    }
    function specialistReservation(data,id) {
      let before = get(/databases/$(database)/documents/specialist_slots/$(data.slotId)).data;
      let after = getAfter(/databases/$(database)/documents/specialist_slots/$(data.slotId)).data;
      return before.status == 'available' && after.status == 'booked'
        && after.appointmentId == id && after.patientId == data.patientId
        && slotMatchesAppointment(after,data) && after.updatedAt == request.time;
    }
    function specialistRelease(data,id) {
      let before = get(/databases/$(database)/documents/specialist_slots/$(data.slotId)).data;
      let after = getAfter(/databases/$(database)/documents/specialist_slots/$(data.slotId)).data;
      return before.status == 'booked' && before.appointmentId == id && before.patientId == data.patientId
        && after.status == 'available' && !after.keys().hasAny(['appointmentId','patientId'])
        && after.updatedAt == request.time;
    }
    function specialistVersionPair(data,id) {
      return getAfter(/databases/$(database)/documents/specialist_appointment_versions/$(id + '-v' + string(data.revision))).data == data;
    }
    match /specialist_slots/{id} {
      function readable() {
        return activeUser() && (specialistScheduleManager(resource.data.clinicId,resource.data.providerId)
          || resource.data.status == 'available' && activeSpecialist(resource.data.clinicId,resource.data.providerId)
            && approvedSpecialist(resource.data.clinicId,resource.data.providerId)
          || resource.data.status == 'booked' && resource.data.patientId == request.auth.uid);
      }
      allow get: if validSlot(resource.data,id) && readable();
      allow list: if boundedQuery() && readable();
      allow create: if validSlot(request.resource.data,id) && request.resource.data.status in ['available','unavailable']
        && request.resource.data.startAt > request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.endAt == request.resource.data.startAt + duration.value(get(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)).data.slotMinutes,'m')
        && specialistScheduleManager(request.resource.data.clinicId,request.resource.data.providerId);
      function bookedPair() {
        let after = getAfter(/databases/$(database)/documents/specialist_appointments/$(request.resource.data.appointmentId)).data;
        return resource.data.status == 'available' && request.resource.data.status == 'booked'
          && activeUser() && activeSpecialist(resource.data.clinicId,resource.data.providerId)
          && approvedSpecialist(resource.data.clinicId,resource.data.providerId)
          && after.status == 'booked' && after.slotId == id && after.updatedAt == request.time
          && after.patientId == request.resource.data.patientId && after.referralId == request.resource.data.appointmentId
          && slotMatchesAppointment(request.resource.data,after);
      }
      function releasedPair() {
        let before = get(/databases/$(database)/documents/specialist_appointments/$(resource.data.appointmentId)).data;
        let after = getAfter(/databases/$(database)/documents/specialist_appointments/$(resource.data.appointmentId)).data;
        return resource.data.status == 'booked' && request.resource.data.status == 'available'
          && before.slotId == id && before.patientId == resource.data.patientId
          && after.revision == before.revision + 1 && after.updatedAt == request.time
          && (after.status in ['cancelled','completed'] || after.status == 'booked' && after.slotId != id);
      }
      allow update: if validSlot(resource.data,id) && validSlot(request.resource.data,id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','appointmentId','patientId','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (resource.data.startAt > request.time && resource.data.status in ['available','unavailable']
            && request.resource.data.status in ['available','unavailable'] && specialistScheduleManager(resource.data.clinicId,resource.data.providerId)
          || bookedPair() || releasedPair());
      allow delete: if false;
    }
    match /specialist_appointments/{id} {
      allow get: if activeUser() && (exists(/databases/$(database)/documents/specialist_appointments/$(id)) ? specialistAppointmentRead(resource.data)
        : get(/databases/$(database)/documents/referrals/$(id)).data.patientId == request.auth.uid
          || get(/databases/$(database)/documents/referrals/$(id)).data.specialistId == request.auth.uid);
      allow list: if boundedQuery() && specialistAppointmentRead(resource.data);
      allow create: if activeUser() && specialistAppointmentShape(request.resource.data,id)
        && request.resource.data.status == 'booked' && request.resource.data.revision == 1
        && request.resource.data.bookedBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && specialistReservation(request.resource.data,id) && specialistVersionPair(request.resource.data,id);
      allow update: if specialistAppointmentShape(request.resource.data,id)
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.revision == resource.data.revision + 1
        && specialistVersionPair(request.resource.data,id)
        && getAfter(/databases/$(database)/documents/referrals/$(id)).data.visitAccessRevokedAt == request.time
        && (request.resource.data.status == 'booked' && resource.data.status in ['booked','cancelled']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slotId','startAt','endAt','status','revision','updatedBy','updatedAt'])
          && specialistReservation(request.resource.data,id)
          && (resource.data.status == 'cancelled' || resource.data.startAt > request.time && specialistRelease(resource.data,id))
        || resource.data.status == 'booked' && request.resource.data.status in ['cancelled','completed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision','updatedBy','updatedAt'])
          && activeUser() && (request.resource.data.status == 'cancelled' && request.auth.uid == resource.data.patientId
            || activeSpecialist(resource.data.clinicId,resource.data.providerId))
          && (request.resource.data.status == 'cancelled' && request.auth.uid in [resource.data.patientId,resource.data.providerId] && resource.data.startAt > request.time
            || request.resource.data.status == 'completed' && request.auth.uid == resource.data.providerId && resource.data.startAt <= request.time)
          && specialistRelease(resource.data,id));
