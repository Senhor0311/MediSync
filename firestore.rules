        && sameQueueDay(get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data)
        && getAfter(/databases/$(database)/documents/queue_states/$(request.resource.data.stateId)).data.changedTicket == request.resource.data.ticket
        && getAfter(/databases/$(database)/documents/queue_states/$(request.resource.data.stateId)).data.waiting.hasAny([request.resource.data.ticket]);
      allow update: if activeUser() && validQueue(resource.data, id)
        && validQueue(request.resource.data, id)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'cancelledAt', 'calledAt', 'completedAt'])
        && queueAppointmentMatches(request.resource.data)
        && queueStateMoved(request.resource.data)
        && (resource.data.status == 'waiting'
          && request.resource.data.status == 'cancelled'
          && checkInActor(get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data)
          && request.resource.data.cancelledAt == request.time
          || resource.data.status == 'waiting'
            && request.resource.data.status == 'called'
            && resource.data.providerId == request.auth.uid
            && activeDoctor(resource.data.clinicId, resource.data.providerId)
            && request.resource.data.calledAt == request.time
          || resource.data.status == 'called'
            && request.resource.data.status == 'completed'
            && resource.data.providerId == request.auth.uid
            && activeDoctor(resource.data.clinicId, resource.data.providerId)
            && request.resource.data.completedAt == request.time);
