          && (before.keys().hasAny(['destinationClinicId']) ? namedReferralAccess(before)
            : activeSpecialist(before.clinicId,request.auth.uid)
              && careFor(before.clinicId,before.patientId,request.auth.uid,'referral',id))
          && after.updatedAt == request.time && before.status == 'pending'
          && after.decisionAt == request.time
          && (after.status == 'accepted'
              && after.diff(before).affectedKeys().hasOnly(['status','decisionAt','updatedAt'])
