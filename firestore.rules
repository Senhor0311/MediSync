    }
    function activeSpecialist(clinicId, specialistId) {
      let member = get(/databases/$(database)/documents/clinic_memberships/$(clinicId)/members/$(specialistId)).data;
      return (request.auth.uid != specialistId || staffAuthentication())
        && activeClinic(clinicId) && member.clinicId == clinicId
        && member.userId == specialistId && member.staffRole == 'specialist'
        && member.status == 'active' && 'operational.read' in member.permissions;
    }

    function approvedSpecialist(clinicId, specialistId) {
      let listing = get(/databases/$(database)/documents/specialist_listings/$(clinicId + '-' + specialistId)).data;
      return listing.listingId == clinicId + '-' + specialistId
        && listing.clinicId == clinicId && listing.specialistId == specialistId
        && listing.status == 'active'
